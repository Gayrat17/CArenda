# ==========================================
# Carenda Production Environment Variables
# Copy to .env.production and fill in real values
# ==========================================

# Django Settings
SECRET_KEY=generate-a-strong-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Tashkent

# PostgreSQL Database
POSTGRES_DB=carenda_db
POSTGRES_USER=carenda_user
POSTGRES_PASSWORD=carenda_password_change_me
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://carenda_user:carenda_password_change_me@db:5432/carenda_db

# Redis & Celery
REDIS_URL=redis://redis:6379/0
REDIS_PORT_BIND=6379

# Telegram Bot & WebApp
# Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Public HTTPS URL of the Mini App (e.g. https://carenda.uz or cloudflared URL)
WEBAPP_URL=https://carenda.yourdomain.uz

# Frontend Internal API Proxy (used by Next.js rewrite inside Docker)
BACKEND_INTERNAL_URL=http://backend:8000

# ==========================================
# Subscription & Payment Verification Settings
# ==========================================
ADMIN_TELEGRAM_ID=
NEXT_PUBLIC_PAYNET_P2P_URL=https://paynet.uz/
NEXT_PUBLIC_CLICK_P2P_URL=https://my.click.uz/
NEXT_PUBLIC_PAYME_P2P_URL=https://payme.uz/
NEXT_PUBLIC_ADMIN_CARD_NUMBER=8600000000000000
NEXT_PUBLIC_ADMIN_CARD_HOLDER=G'AYRATJON X.
