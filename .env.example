# ==========================================
# Carenda Environment Variables Template
# Copy to .env and fill in real values
# ==========================================

# Django Settings
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Tashkent

# PostgreSQL Database
DATABASE_URL=postgres://carenda_user:carenda_password_change_me@localhost:5432/carenda_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Telegram Bot & WebApp
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
WEBAPP_URL=http://localhost:3000

# ==========================================
# Subscription & Payment Verification Settings
# ==========================================
ADMIN_TELEGRAM_ID=
NEXT_PUBLIC_PAYNET_P2P_URL=https://paynet.uz/
NEXT_PUBLIC_CLICK_P2P_URL=https://my.click.uz/
NEXT_PUBLIC_PAYME_P2P_URL=https://payme.uz/
NEXT_PUBLIC_ADMIN_CARD_NUMBER=8600000000000000
NEXT_PUBLIC_ADMIN_CARD_HOLDER=G'AYRATJON X.
